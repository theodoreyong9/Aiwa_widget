<?xml version="1.0" encoding="utf-8"?>
<!-- Two rows: the conversation (Aiwa / session / mic / model / Claude) and,
     when the widget is at least two cells high, the GitHub project (repository,
     Push, Deploy, site, Actions). Everything is always there: the narrowest it
     can be resized to is the width the fullest row needs. It can be shrunk to
     the single row. The lists open in floating picker windows, so they need no
     room in the widget. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android" android:minWidth="360dp" android:minHeight="110dp" android:minResizeWidth="340dp" android:minResizeHeight="56dp" android:targetCellWidth="6" android:targetCellHeight="2" android:resizeMode="horizontal|vertical" android:updatePeriodMillis="0" android:initialLayout="@layout/aiwa_widget_placeholder" android:previewLayout="@layout/aiwa_widget_preview" android:previewImage="@drawable/aiwa_widget_preview" android:description="@string/widget_description" android:widgetCategory="home_screen" />
