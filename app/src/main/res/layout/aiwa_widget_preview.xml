<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker's preview on Android 12+ (previewLayout): the two rows
     of the real widget, drawn with plain views so the launcher can render it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/preview_bg" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="6dp" android:paddingBottom="6dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/preview_circle" android:gravity="center" android:text="A" android:textColor="#E4E4EB" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:background="@drawable/preview_pill" android:paddingStart="11dp" android:paddingEnd="11dp" android:paddingTop="11dp" android:paddingBottom="11dp" android:singleLine="true" android:text="Nouvelle session ▾" android:textColor="#E4E4EB" android:textSize="12sp" android:textStyle="bold" android:layout_marginStart="6dp" />
        <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="6dp" android:background="@drawable/preview_mic">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="center" android:src="@drawable/rec_dot" />
        </FrameLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/preview_pill" android:paddingStart="11dp" android:paddingEnd="11dp" android:paddingTop="11dp" android:paddingBottom="11dp" android:singleLine="true" android:text="Auto ▾" android:textColor="#E4E4EB" android:textSize="12sp" android:textStyle="bold" android:layout_marginStart="6dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/preview_pill_orange" android:paddingStart="11dp" android:paddingEnd="11dp" android:paddingTop="11dp" android:paddingBottom="11dp" android:singleLine="true" android:text="Claude ↗" android:textColor="#E4E4EB" android:textSize="12sp" android:textStyle="bold" android:layout_marginStart="6dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:background="@drawable/preview_pill" android:paddingStart="11dp" android:paddingEnd="11dp" android:paddingTop="11dp" android:paddingBottom="11dp" android:singleLine="true" android:text="⎇ GitHub ▾" android:textColor="#E4E4EB" android:textSize="12sp" android:textStyle="bold"  />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/preview_pill_green" android:paddingStart="11dp" android:paddingEnd="11dp" android:paddingTop="11dp" android:paddingBottom="11dp" android:singleLine="true" android:text="Push: main" android:textColor="#E4E4EB" android:textSize="12sp" android:textStyle="bold" android:layout_marginStart="6dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/preview_pill" android:paddingStart="11dp" android:paddingEnd="11dp" android:paddingTop="11dp" android:paddingBottom="11dp" android:singleLine="true" android:text="Deploy ○" android:textColor="#E4E4EB" android:textSize="12sp" android:textStyle="bold" android:layout_marginStart="6dp" />
    </LinearLayout>
</LinearLayout>
