<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker's preview on Android 12+ (previewLayout): the four bands
     of the real widget, drawn with plain views so the launcher can render it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg" android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="8dp" android:paddingBottom="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/preview_circle" android:gravity="center" android:text="A" android:textColor="#E8967C" android:textSize="17sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:text="Nouvelle session ▾" android:textColor="#F0F0F5" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:text="Prêt" android:textColor="#A0A0AE" android:textSize="11sp" />
        </LinearLayout>
        <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:background="@drawable/preview_circle_orange">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_claude" />
        </FrameLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:background="@drawable/preview_pill" android:gravity="center_vertical|start" android:paddingStart="10dp" android:paddingEnd="10dp" android:singleLine="true" android:text="⎇ aiwa_widget ▾" android:textColor="#F0F0F5" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:background="@drawable/preview_pill" android:gravity="center_vertical|start" android:paddingStart="10dp" android:paddingEnd="10dp" android:singleLine="true" android:text="Sonnet 5.5 ▾" android:textColor="#F0F0F5" android:textSize="12sp" android:textStyle="bold" android:layout_marginStart="6dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:background="@drawable/preview_pill_green" android:gravity="center_vertical|start" android:paddingStart="10dp" android:paddingEnd="10dp" android:singleLine="true" android:text="Push main" android:textColor="#F0F0F5" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:background="@drawable/preview_pill_green" android:gravity="center_vertical|start" android:paddingStart="10dp" android:paddingEnd="10dp" android:singleLine="true" android:text="Deploy ●" android:textColor="#F0F0F5" android:textSize="12sp" android:textStyle="bold" android:layout_marginStart="6dp"/>
        <FrameLayout android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="6dp" android:background="@drawable/preview_circle_orange"><ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_globe" /></FrameLayout>
        <FrameLayout android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="6dp" android:background="@drawable/preview_circle_green"><ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_actions" /></FrameLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:background="@drawable/preview_mic_pill" android:gravity="center" android:orientation="horizontal">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/rec_dot" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:singleLine="true" android:text="Dicter un message" android:textColor="#F0F0F5" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
