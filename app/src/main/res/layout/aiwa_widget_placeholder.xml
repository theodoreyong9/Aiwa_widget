        <ProgressBar style="?android:attr/progressBarStyleSmall" android:layout_width="18dp" android:layout_height="18dp" android:indeterminate="true" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="Aiwa · chargement…" android:textColor="#E4E4EB" android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>
