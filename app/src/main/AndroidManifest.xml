<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Needed for LocalClaudeBridge's own HTTP calls to the local
         backend — without it no socket can open at all, cleartext
         policy or not. Was never declared here even before this fix. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:allowBackup="true" android:label="Aiwa" android:supportsRtl="true" android:theme="@style/Theme.Aiwa" android:networkSecurityConfig="@xml/network_security_config">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".AiwaWidgetReceiver" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/aiwa_widget_info" />
        </receiver>
    </application>
</manifest>
